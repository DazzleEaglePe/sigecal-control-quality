# PostgreSQL local
POSTGRES_USER="sigecal"
POSTGRES_PASSWORD="change-only-for-local-development"
POSTGRES_DB="sigecal"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://sigecal:change-only-for-local-development@localhost:5432/sigecal?schema=public"

# Authentication — replace both values with different 64+ character secrets
JWT_ACCESS_SECRET="replace-with-a-unique-random-secret-of-at-least-64-characters"
JWT_REFRESH_SECRET="replace-with-another-unique-random-secret-of-at-least-64-characters"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
BCRYPT_ROUNDS=10

# Application
NODE_ENV="development"
PORT=3000
WEB_PORT=5173
CORS_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:3000/api/v1"
API_PREFIX="/api/v1"
COOKIE_SECURE=false
COOKIE_SAME_SITE="strict"
COOKIE_PATH="/api/v1/auth"

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# Initial data — define a non-production value only in the untracked .env file
SEED_ADMIN_EMAIL="admin@sigecal.pe"
SEED_DEFAULT_PASSWORD="replace-in-your-local-env"

# Copy this file to .env.production on the deployment host and protect it.
# Run Compose with: docker compose --env-file .env.production -f docker-compose.production.yml

# PostgreSQL: use unique values from a secret manager.
POSTGRES_USER=sigecal
POSTGRES_PASSWORD='replace-with-a-unique-database-password'
POSTGRES_DB=sigecal
DATABASE_URL=postgresql://sigecal:replace-with-a-unique-database-password@postgres:5432/sigecal?schema=public

# Public HTTPS origin served by the upstream TLS reverse proxy.
WEB_PORT=8080
SIGECAL_IMAGE_TAG=release-2026-10-05

# Authentication: generate two different random secrets, each at least 64 characters.
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-64-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-64-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# Application and secure same-site cookie.
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://sigecal.example.com
VITE_API_URL=/api/v1
API_PREFIX=/api/v1
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_PATH=/api/v1/auth

# Rate limiting and lockout.
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# Real SMTP provider. Never point production at Mailpit.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# false on 587: the API requires STARTTLS; true only for implicit TLS (usually 465).
MAIL_SECURE=false
MAIL_USER=replace-with-the-smtp-username
MAIL_PASSWORD='replace-with-the-smtp-password'
MAIL_FROM='SIGECAL <no-responder@example.com>'
WEB_BASE_URL=https://sigecal.example.com
ACTIVATION_TOKEN_MINUTES=1440
PASSWORD_RESET_TOKEN_MINUTES=30

{
  "name": "@sigecal/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de SIGECAL",
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace @sigecal/shared",
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run build --workspace @sigecal/shared",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma format && prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:verify-seed": "tsx prisma/verify-seed.ts",
    "lint": "eslint src prisma prisma.config.ts --max-warnings=0",
    "pretest": "npm run build --workspace @sigecal/shared",
    "test": "vitest run",
    "pretypecheck": "npm run build --workspace @sigecal/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sigecal/shared": "0.1.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "jose": "6.2.10",
    "nodemailer": "9.1.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.9.1",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
